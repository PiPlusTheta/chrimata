# Local PostgreSQL service from docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chrimata
CORS_ORIGINS=http://localhost:3000

# Required for the full streamed Ask experience and the default Hindsight path.
# Replace this placeholder in your local backend/.env file. Never commit a real key.
XAI_API_KEY=replace-with-your-xai-api-key
XAI_MODEL=grok-3

# Optional Hindsight provider override. When configured, Hindsight uses OpenRouter
# before the xAI fallback. This does not replace XAI_API_KEY for streamed chat.
# OPENROUTER_API_KEY=
# HINDSIGHT_LLM_MODEL=openai/gpt-4o-mini

# Optional provider for supported non-streaming agent calls / Hindsight fallback.
# OPENAI_API_KEY=
